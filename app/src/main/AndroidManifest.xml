<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />

    <!-- Talk to the other phone over Bluetooth -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Keep the link running with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Main phone: see incoming calls, answer / reject them from the bike -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Ride screen: show the call pop-up even when the screen is off -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Ride screen: floating call and message cards on top of Google Maps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Main phone: open Google Maps short links to find a shared place's exact location -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Start the link by itself after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Show music app names (YouTube Music, Spotify...) on the ride screen -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Official document apps: to find the IDs screen inside Samsung Wallet. -->
        <package android:name="com.samsung.android.spay" />
        <package android:name="com.samsung.android.samsungpass" />
        <package android:name="com.digilocker.android" />
        <package android:name="com.nic.mparivahan" />
    </queries>

    <application
        android:name=".DarksRideApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DarksRide">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.DarksRide"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Ride panel on a second screen (LG Wing's small screen in Swivel mode) -->
        <activity
            android:name=".panel.RidePanelActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:taskAffinity="com.darksoul.darksride.panel"
            android:theme="@style/Theme.DarksRide" />

        <!-- "Send to bike" in the share menu: places from Google Maps / WhatsApp -->
        <activity
            android:name=".nav.ShareToBikeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Send to bike"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Keeps the phone-to-phone Bluetooth link alive -->
        <service
            android:name=".link.LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Main phone: notification access, used for music control (and notifications in step 5) -->
        <service
            android:name=".phone.PhoneListenerService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Starts the link after a phone restart or an app update -->
        <receiver
            android:name=".link.StartupReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>